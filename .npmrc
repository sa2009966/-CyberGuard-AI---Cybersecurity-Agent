# pnpm configuration optimized for Vercel serverless builds

# Use hoisted node-linker to flatten the node_modules structure
# This helps Vercel's build system find modules more reliably
node-linker=hoisted

# Strict peer dependency resolution to catch issues early
strict-peer-dependencies=false

# Allow optional peer dependencies (Discord.js native modules)
auto-install-peers=true

# Don't fail on missing optional dependencies
optional-dependencies=true

# Use the network for dependency resolution (required for Vercel CI)
prefer-offline=false

# Increase resolution timeout for flaky networks
fetch-timeout=60000
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Use the latest npm registry
registry=https://registry.npmjs.org/
